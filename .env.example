# === Telegram ===
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ID чата/группы, откуда брать заявки (можно несколько через запятую)
# Узнать ID: добавь бота в чат, напиши любое сообщение — в логах появится chat_id
TELEGRAM_CHAT_IDS=-1001234567890

# Если true — обрабатывать только сообщения с ключевыми словами (см. ниже)
FILTER_BY_KEYWORDS=false
# Ключевые слова через запятую (регистр не важен). Пусто = все сообщения
KEYWORDS=заявка,лид,новый клиент,телефон,имя

# Игнорировать сообщения от ботов
IGNORE_BOTS=true

# Минимальная длина текста для создания лида
MIN_MESSAGE_LENGTH=5

# Отвечать в Telegram после создания лида (true/false). false = без уведомлений в чате
REPLY_IN_TELEGRAM=false

# Только заявки квиза ("Заявка на квиз ..."), остальная переписка в чате игнорируется
ONLY_QUIZ_APPLICATIONS=true

# Прямой webhook Marquiz (рекомендуется: бот не видит сообщения MarquizBot)
MARQUIZ_HTTP_ENABLED=true
MARQUIZ_HTTP_HOST=127.0.0.1
MARQUIZ_HTTP_PORT=8791

# === Bitrix24 (можно вместе с EspoCRM) ===
# Входящий вебхук: Битрикс24 → Разработчикам → Другое → Входящий вебхук
# Нужны права: CRM (crm)
# Пример: https://your-domain.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
# BITRIX_ENABLED=true

# Что создавать: lead | deal
BITRIX_ENTITY=lead

# ID воронки и стадии для сделок (только если BITRIX_ENTITY=deal)
# BITRIX_DEAL_CATEGORY_ID=0
# BITRIX_DEAL_STAGE_ID=NEW

# Источник лида (опционально, ID из справочника источников CRM)
# BITRIX_SOURCE_ID=WEB

# Ответственный менеджер (ID пользователя Битрикс24). Пусто = по умолчанию
# BITRIX_ASSIGNED_BY_ID=1

# === EspoCRM (можно вместе с Bitrix24) ===
# URL инстанса без /api/v1 (он добавится сам)
# ESPO_URL=https://crm.example.com
# API Key: Administration → API Users → Create (права на Lead)
# ESPO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# ESPO_ENABLED=true
# ESPO_ENTITY=Lead
# ESPO_LEAD_STATUS=New
# ESPO_SOURCE=Web Site
# ESPO_ASSIGNED_USER_ID=
# Опциональный маппинг ответов квиза в кастомные поля Espo:
# ESPO_FIELD_MAP=quiz_name:cQuizName,тип led:cLedType,ширина:cWidth,высота:cHeight,city:cCity,vk:cVk,telegram:cTelegram,max:cMax

# === Planfix (можно вместе с Bitrix/Espo) ===
# REST endpoint аккаунта, например https://medialive.planfix.ru/rest/
# PLANFIX_URL=https://medialive.planfix.ru/rest/
# Токен: Управление аккаунтом → Доступ к API → REST API
# Нужны scopes: contact_add, contact_readonly, task_add, task_update
# PLANFIX_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PLANFIX_ENABLED=true
# Опционально: шаблоны контакта/задачи и ответственный сотрудник
# PLANFIX_CONTACT_TEMPLATE_ID=1
# Шаблон задачи «Сделка» (у MediaLive id=15)
# PLANFIX_TASK_TEMPLATE_ID=15
# PLANFIX_ASSIGNEE_USER_ID=

# === Режим работы ===
# polling — простой запуск на VPS без HTTPS (рекомендуется)
# webhook — нужен публичный HTTPS URL
MODE=polling

# Только для MODE=webhook
# WEBHOOK_URL=https://your-vps.example.com/telegram
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8080
# WEBHOOK_PATH=/telegram

# === Логи ===
LOG_LEVEL=INFO
